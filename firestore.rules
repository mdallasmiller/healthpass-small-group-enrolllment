rules_version = '2';

// Security model:
//  - Admins (authenticated staff) manage groups, rates, and rosters from the admin portal.
//  - The EMPLOYEE enrollment portal does NOT write here directly. All employee/PHI reads
//    and writes go through Cloud Functions (Admin SDK), authorized by the per-employee
//    unique token + access code. The Admin SDK bypasses these rules, so we can default-deny
//    everything for clients and only open the admin surface.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // An admin is a user with a doc under /admins/{uid}
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin directory: an admin can read their own record.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // TEMP (dev bootstrap): while Cloud Functions are not deployed (Spark),
      // allow a signed-in user to self-provision their own admin record.
      // Replace with the first-admin-only bootstrapFirstAdmin function before production.
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Groups and everything under them: admins only.
    // Employee enrollment writes happen server-side via Functions (Admin SDK).
    match /groups/{groupId} {
      allow read, write: if isAdmin();

      // TEMP (dev): the enrollment portal signs in anonymously and reads a single
      // group doc (plan config) by id. Listing stays admin-only. In production
      // this is replaced by a Cloud Function exposing only the needed fields.
      allow get: if isSignedIn();

      // Portal reads a single employee doc (by id from the invite link) to
      // validate the access code. Listing the roster stays admin-only.
      match /employees/{employeeId} {
        allow read, write: if isAdmin();
        allow get: if isSignedIn();
      }

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
